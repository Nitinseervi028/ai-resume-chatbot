# Copy this file to .env and fill in real values before running
# `docker compose up`. .env is gitignored/dockerignored -- never commit it.

# Required: OpenRouter key used for all LLM calls (extraction, generation,
# ATS scoring, resume editing).
OPENROUTER_API_KEY=

# Required: Firecrawl key used to scrape job postings (handles JS-rendered
# and bot-protected sites like most modern job boards).
FIRECRAWL_API_KEY=

# Optional: raises the GitHub REST API rate limit from 60/hr to 5000/hr
# when fetching a candidate's repos. Works fine without it for light use.
GITHUB_TOKEN=
